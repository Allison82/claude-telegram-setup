<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 進階版：透過 start_telegram_channel.sh 每次自動接回「最新的 session」 -->
    <key>Label</key>
    <string>com.YOUR_USERNAME.claude-telegram-channel</string>

    <key>ProgramArguments</key>
    <array>
        <!-- launchd 沒有 TTY；script 提供 pseudo-TTY -->
        <string>/usr/bin/script</string>
        <string>-q</string>
        <string>/dev/null</string>
        <string>/YOUR_HOME/.claude/channels/telegram/start_telegram_channel.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/YOUR_HOME/.claude/channels/telegram/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/YOUR_HOME/.claude/channels/telegram/launchd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/YOUR_HOME</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/YOUR_HOME</string>
        <key>PATH</key>
        <string>/YOUR_HOME/.bun/bin:/YOUR_HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
