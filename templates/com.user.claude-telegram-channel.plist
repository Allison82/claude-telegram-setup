<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.YOUR_USERNAME.claude-telegram-channel</string>

    <key>ProgramArguments</key>
    <array>
        <!-- claude 執行檔路徑，通常是 /usr/local/bin/claude 或 ~/.npm-global/bin/claude -->
        <string>/PATH/TO/claude</string>
        <!-- 填入你要固定的 session id（用 claude --list-sessions 查） -->
        <string>--resume</string>
        <string>YOUR_SESSION_ID_HERE</string>
        <string>--channels</string>
        <string>plugin:telegram@claude-plugins-official</string>
        <string>--dangerously-skip-permissions</string>
    </array>

    <!-- 登入後自動啟動 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 掛掉 30 秒內自動重啟 -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- log 路徑（替換 YOUR_HOME） -->
    <key>StandardOutPath</key>
    <string>/YOUR_HOME/.claude/channels/telegram/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/YOUR_HOME/.claude/channels/telegram/launchd.err.log</string>

    <!-- 工作目錄（替換 YOUR_HOME） -->
    <key>WorkingDirectory</key>
    <string>/YOUR_HOME</string>
</dict>
</plist>
