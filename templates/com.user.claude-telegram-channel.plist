<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.YOUR_USERNAME.claude-telegram-channel</string>

    <key>ProgramArguments</key>
    <array>
        <!-- launchd 沒有 TTY；script 提供 pseudo-TTY，避免 Claude 誤切成 --print 後退出 -->
        <string>/usr/bin/script</string>
        <string>-q</string>
        <string>/dev/null</string>
        <!-- claude 執行檔路徑 -->
        <string>/PATH/TO/claude</string>
        <!-- 填入你要固定的 session id（用 claude --list-sessions 查） -->
        <string>--resume</string>
        <string>YOUR_SESSION_ID_HERE</string>
        <string>--channels</string>
        <string>plugin:telegram@claude-plugins-official</string>
        <string>--dangerously-skip-permissions</string>
    </array>

    <!-- 登入後自動啟動 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 掛掉 30 秒內自動重啟 -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- log 路徑（替換 YOUR_HOME） -->
    <key>StandardOutPath</key>
    <string>/YOUR_HOME/.claude/channels/telegram/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/YOUR_HOME/.claude/channels/telegram/launchd.err.log</string>

    <!-- 工作目錄（替換 YOUR_HOME） -->
    <key>WorkingDirectory</key>
    <string>/YOUR_HOME</string>

    <!-- 必須包含 Bun，否則 telegram plugin 會找不到 bun -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/YOUR_HOME/.bun/bin:/YOUR_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
